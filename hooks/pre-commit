#!/usr/bin/env bash
# rcrwhyg Git pre-commit 钩子（轻量快速，目标 < 15 秒）
# 安装：./tools/install-hooks.sh
# 紧急跳过（不推荐）：git commit --no-verify

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo "[pre-commit] 提交前校验..."

# ---------- 1. 禁止提交敏感文件 ----------
# 豁免 staged 的删除（git rm --cached 移除跟踪是合法且推荐的）
SENSITIVE='^\.env$|^\.env\..*$|id_rsa|\.pem$|\.key$|credentials'
STAGED_SENSITIVE=$(git diff --cached --name-only --diff-filter=d | grep -E "$SENSITIVE" || true)
if [ -n "$STAGED_SENSITIVE" ]; then
    echo -e "${RED}[FAIL]${NC} 检测到敏感文件被暂存："
    echo "$STAGED_SENSITIVE"
    echo "如确需移除跟踪：git rm --cached <file>（保留磁盘文件）"
    exit 1
fi

# ---------- 2. 暂存内容密钥扫描 ----------
# 只扫描本次暂存「新增行」中的疑似凭据（排除模板 .env.example 与钩子/脚本自身）
LEAKS=$(git diff --cached -U0 --no-color -- . ':!.env.example' ':!hooks/*' ':!tools/*' \
    | grep -E '^\+[^+]' \
    | grep -E \
        -e 'postgres(ql)?://[^[:space:]@/]+:[^[:space:]@]+@' \
        -e '(api[_-]?key|apikey|secret[_-]?key|access[_-]?token|bearer)[[:space:]]*[=:][[:space:]]*["'"'"']?[A-Za-z0-9_-]{16,}' \
    || true)
if [ -n "$LEAKS" ]; then
    echo -e "${RED}[FAIL]${NC} 暂存内容中发现疑似凭据："
    echo "$LEAKS"
    echo "确认为误报后，请调整写法（占位符 / 环境变量引用）再提交。"
    exit 1
fi

# ---------- 3. Rust 格式检查 ----------
echo "[pre-commit] cargo fmt --all --check"
if ! cargo fmt --all --check; then
    echo -e "${RED}[FAIL]${NC} 格式检查未通过。运行 'cargo fmt --all' 修复后重新提交。"
    exit 1
fi

# ---------- 4. 文章静态检查（仅当 articles/ 有暂存改动时） ----------
if git diff --cached --name-only | grep -q '^articles/.*\.md$'; then
    echo "[pre-commit] tools/check-articles.sh"
    if ! ./tools/check-articles.sh; then
        echo -e "${RED}[FAIL]${NC} 文章静态检查未通过，请按提示修复。"
        exit 1
    fi
fi

echo -e "${GREEN}[pre-commit]${NC} 校验通过"
