[Unit]
Description=rcrwhyg-server (Leptos SSR, musl static)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=rcrwhyg
Group=rcrwhyg
WorkingDirectory=/opt/rcrwhyg
ExecStart=/opt/rcrwhyg/rcrwhyg-server
EnvironmentFile=/opt/rcrwhyg/.env
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillMode=mixed
KillSignal=SIGTERM
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/rcrwhyg
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rcrwhyg

[Install]
WantedBy=multi-user.target
