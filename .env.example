# Copy to `.env` for local development. Never commit `.env`.

# Postgres — used by app + soft-gated DB tests.
# psql "$DATABASE_URL" -f sql/posts.sql -f sql/seed_posts.sql -f sql/auth.sql
# Bootstrap admin (server shell only; no public /admin/setup):
#   cargo run --features ssr --bin create-admin -- you@example.com 'at-least-12-chars'
DATABASE_URL=postgres://user:password@127.0.0.1:5432/rcrwhyg

# Session cookie: set true behind HTTPS (production / Caddy).
# Local http://127.0.0.1 usually needs false so the cookie sticks.
COOKIE_SECURE=false
SESSION_TTL_HOURS=72

# Per-IP rate limits (governor). Auth is stricter than public browsing.
RATE_LIMIT_PUBLIC_PER_MIN=180
RATE_LIMIT_AUTH_PER_MIN=8

# LEPTOS_ENV=PROD enables Secure cookies when COOKIE_SECURE is unset.
# LEPTOS_SITE_ADDR=127.0.0.1:3000
